{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openfit-health-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "FittyHealthAgent",
        "class_name": "FittyHealthAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FittyHealthAgent"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://avg-francesco-fitty.expo.app,fitty://oauth,com.francescooddo.fitty://oauth",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "STRAVA_CLIENT_ID": "",
    "STRAVA_POLICY_APPROVED": "false",
    "STRAVA_WEBHOOK_READY": "false",
    "GARMIN_CLIENT_ID": "",
    "GARMIN_PARTNER_APPROVED": "false",
    "GARMIN_AUTHORIZATION_URL": "",
    "GARMIN_TOKEN_URL": "",
    "GARMIN_USER_ID_URL": "",
    "GARMIN_PERMISSIONS_URL": "",
    "GARMIN_DISCONNECT_URL": ""
  },
  "observability": {
    "enabled": true
  }
}
